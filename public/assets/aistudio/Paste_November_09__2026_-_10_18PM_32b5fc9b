export interface TopicScore { topic: string; score: number }
export interface StudyPlanItem { topic: string; reason: string; suggestedQuestions: string[] }
export interface InterviewReport { sessionId: string; config: InterviewConfig; startedAt: string; completedAt: string; durationSec: number; overallScore: number; scores: RubricScores; topicScores: TopicScore[]; strengths: string[]; weaknesses: string[]; results: QuestionResult[]; studyPlan: StudyPlanItem[]; summaryFeedback: string; summaryAudioUrl?: string | null }
export interface SessionSummary { sessionId: string; config: InterviewConfig; startedAt: string; status: SessionStatus; overallScore: number | null; durationSec: number }
export interface DashboardStats { totalInterviews: number; avgScore: number; bestScore: number; practiceMinutes: number; streakDays: number; trend: { date: string; score: number }[]; weakTopics: TopicScore[] }

SHARED CONSTANTS: lib/constants.ts (create if missing)
- RUBRIC_WEIGHTS = { technicalCorrectness: 0.35, conceptualUnderstanding: 0.25, completeness: 0.20, relevance: 0.10, communicationClarity: 0.10 }
- RUBRIC_LABELS = human labels for the five keys (Technical correctness, Conceptual understanding, Completeness, Relevance, Communication clarity)
- TECHNICAL_DOMAINS = ['Python','Java','JavaScript','SQL','DBMS','Operating Systems','Computer Networks','Data Structures & Algorithms','OOP','System Design','Machine Learning']
- HR_DOMAINS = ['Self Introduction','Behavioural','Situational','Strengths & Weaknesses','Career Goals']
- LANGUAGES = [{ value:'en', label:'English', native:'English', enabled:true }, { value:'ta', label:'Tamil', native:'தமிழ்', enabled:true }, { value:'hi', label:'Hindi', native:'हिन्दी', enabled:false }]
- DURATIONS = [{min:5, approxQuestions:'3-4'}, {min:10, approxQuestions:'6-8'}, {min:15, approxQuestions:'10-12'}]
- SESSION_STORAGE_KEY = (id: string) => `iq:session:${id}`

SHARED HELPERS: lib/utils.ts exports cn, formatDuration(sec) → "4m 12s", formatDate(iso) → "09 Nov 2026", scoreTone(score) → 'success' (>=75) | 'warning' (50-74) | 'destructive' (<50), scoreLabel(score) → 'Excellent' (>=85) | 'Good' (70-84) | 'Fair' (50-69) | 'Needs work'.

API CLIENT: lib/api.ts (create if missing; every page uses it, never raw fetch)
const BASE = process.env.NEXT_PUBLIC_API_BASE_URL ?? 'http://localhost:8000'; const USE_MOCK = process.env.NEXT_PUBLIC_USE_MOCK === 'true'
All functions take an optional last arg `token?: string` (Clerk JWT) sent as `Authorization: Bearer <token>`. When USE_MOCK is true they return data from lib/mock-data.ts after a 600-1800ms delay. Signatures:
- startSession(config: InterviewConfig, token?) → StartSessionResponse         POST /api/sessions
- submitAnswer(sessionId: string, questionId: string, audio: Blob, token?) → SubmitAnswerResponse   POST /api/sessions/{id}/answer (multipart: questionId, audio)
- endSession(sessionId: string, token?) → { sessionId: string }               POST /api/sessions/{id}/end
- getReport(sessionId: string, token?) → InterviewReport                      GET /api/sessions/{id}/report
- listSessions(token?) → SessionSummary[]                                     GET /api/sessions
- getStats(token?) → DashboardStats                                           GET /api/stats
Throw an ApiError(status, message) on non-2xx. Get the token in components with: const { getToken } = useAuth(); const token = (await getToken()) ?? undefined.

MOCK DATA: lib/mock-data.ts exports mockStats, mockSessions (6 realistic sessions, mix of types/domains/scores, one in_progress), mockQuestionPool (adaptive-looking Python/SQL/OS questions incl. follow-ups), and mockReport(sessionId) returning a full realistic InterviewReport (5 question results, topic scores, study plan). Mock submitAnswer returns the next question from the pool and isComplete=true after 4 answers. audioUrl is null in mock mode.

SESSION HAND-OFF (Setup page → Interview room): after startSession succeeds, the Setup page saves JSON { config, firstQuestion, startedAt } to sessionStorage under SESSION_STORAGE_KEY(sessionId) and navigates to /session/{sessionId}. The room reads it from there (if missing → redirect to /setup).

